# Copy to .env and adjust. Every setting is optional.

# The public address of your planner, used in e-mail links (password reset, address confirmation).
# Without it the address is taken from the request.
APP_URL=https://planner.example.com

# E-mail (optional). With SMTP set up, new addresses are confirmed and passwords can be reset by e-mail.
# Without it, sign-ups are not confirmed and passwords are reset from the server:
#   docker compose exec planner node server/src/cli.mjs reset-password you@example.com
SMTP_URL=
# e.g. smtps://user:password@smtp.example.com:465
MAIL_FROM=Shutdown Complete <planner@example.com>

# Keep true behind HTTPS. Set false only to try it over plain http.
COOKIE_SECURE=true

# AGPL-3.0: if you run a modified copy for other people, point this at your source code.
SOURCE_URL=

# Host port nginx proxies to (bound to 127.0.0.1 only).
PLANNER_PORT=3000
